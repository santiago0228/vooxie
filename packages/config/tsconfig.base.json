{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-native",
    "paths": {
      "@vooxie/ui": ["../../packages/ui/src"],
      "@vooxie/ui/*": ["../../packages/ui/src/*"],
      "@vooxie/core": ["../../packages/core/src"],
      "@vooxie/core/*": ["../../packages/core/src/*"]
    }
  }
}
