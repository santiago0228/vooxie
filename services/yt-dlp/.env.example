# Microservicio yt-dlp — NUNCA subas valores reales.
# Genera el token con: openssl rand -hex 32
SERVICE_AUTH_TOKEN=
PORT=8080
# Opcionales
# SEARCH_TIMEOUT_S=20
# EXTRACT_TIMEOUT_S=30
# MAX_CONCURRENCY=4
# SEARCH_MAX_RESULTS=20
# MUSIC_ONLY=true   # filtra entrevistas, reacciones, directos largos, shorts…
# YTDLP_COOKIES_FILE=/run/secrets/cookies.txt   # si YouTube bloquea la IP del servidor
# YTDLP_PROXY=http://usuario:clave@host:puerto   # alternativa: proxy residencial
# SEARCH_CACHE_TTL_S=600
