# Secretos de la Edge Function `youtube-proxy`.
# Se cargan con:  supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase solo.)
YTDLP_SERVICE_URL=https://TU-SERVICIO-YTDLP.example.com
YTDLP_SERVICE_TOKEN=
# Opcional: orígenes web con CORS (Expo web / panel admin), separados por coma.
# Las apps nativas no necesitan CORS. Vacío = ningún origen web permitido.
ALLOWED_ORIGINS=
