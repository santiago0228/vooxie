# ── APP (apps/vooxie y apps/vooxie-artistas) ─────────────────────────────────
# Copia como .env en la raíz. Solo valores PÚBLICOS: terminan dentro del bundle.
# NUNCA subas el .env real a git.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=TU-ANON-KEY-PUBLICA

# Deep linking (placeholder hasta que exista el dominio real)
VOOXIE_WEB_DOMAIN=https://vooxie.app

# ⛔ NO pongas aquí: SUPABASE_SERVICE_ROLE_KEY, YTDLP_SERVICE_URL, YTDLP_SERVICE_TOKEN.
#    Ni como EXPO_PUBLIC_*: todo EXPO_PUBLIC_* se incrusta en la app.

# ── IMPORTADOR (services/importer) — variables de TU TERMINAL, no de la app ──
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / YTDLP_SERVICE_URL / YTDLP_SERVICE_TOKEN
# (ver README → "Importador de artistas"). No las guardes en este archivo.
